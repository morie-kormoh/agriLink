// Module 05 — Farm Records & Profit Summary

enum RecordType {
  INPUT_PURCHASE
  LABOUR
  LAND_PREP
  TRANSPORT
  OTHER_COST
  HARVEST
  SALE
  OTHER_INCOME
}

enum RecordSource {
  USSD
  APP
  AGENT
  COOP
  AUTO_PURCHASE
  AUTO_VOUCHER
  AUTO_PAYMENT
}

enum Verification {
  SELF_REPORTED
  AGENT_CONFIRMED
  SYSTEM_VERIFIED
}

model FarmRecord {
  id           String       @id @default(cuid())
  farmerId     String
  farmer       Farmer       @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropCycleId  String?
  cropId       String?
  season       String
  type         RecordType
  description  String?
  quantity     Decimal?     @db.Decimal(12, 2)
  unit         String?
  amountLe     Decimal?     @db.Decimal(14, 2)
  occurredAt   DateTime
  source       RecordSource
  verification Verification @default(SELF_REPORTED)
  /// purchaseId / voucherId for automatic records (idempotency)
  sourceRef    String?      @unique
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([farmerId, season])
}

model SeasonSummary {
  id            String    @id @default(cuid())
  farmerId      String
  farmer        Farmer    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  season        String
  totalCostLe   Decimal   @db.Decimal(14, 2)
  totalSalesLe  Decimal   @db.Decimal(14, 2)
  harvestKg     Decimal   @db.Decimal(12, 2)
  netLe         Decimal   @db.Decimal(14, 2)
  recordCount   Int
  /// % of sales+cost value that is system-verified (0–100)
  verifiedShare Decimal   @db.Decimal(5, 2)
  byType        Json
  generatedAt   DateTime  @default(now())
  smsSentAt     DateTime?

  @@unique([farmerId, season])
}
