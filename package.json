{
  "name": "agrilink",
  "private": true,
  "description": "AgriLink Salone \u2014 Empowering Farmers Through Digital Finance",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @agrilink/db generate",
    "db:migrate": "pnpm --filter @agrilink/db migrate",
    "db:deploy": "pnpm --filter @agrilink/db deploy",
    "db:seed": "pnpm --filter @agrilink/db seed",
    "db:studio": "pnpm --filter @agrilink/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@agrilink/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "turbo": "^2.11.11",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@node-rs/argon2",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core"
    ]
  }
}
