# ---- Database (docker compose: postgis/postgis:16) ----
DATABASE_URL=postgresql://agripay:agripay@localhost:5432/agripay
DATABASE_URL_TEST=postgresql://agripay:agripay@localhost:5432/agripay_test

# ---- Redis (rate limits, queues) ----
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO locally, S3 in production) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=agripay

# ---- App ----
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Shared secret for apps/ussd -> apps/web internal API
INTERNAL_API_TOKEN=change-me-internal-token
DEFAULT_LOCALE=en

# ---- Channels / providers ----
SMS_PROVIDER=console
# Development only: every login code is this value (ignored in test/production). Leave empty for random codes.
DEV_OTP_CODE=123456
PAYMENT_PROVIDER_MODE=mock
USSD_PORT=4000

# ---- Observability (optional) ----
SENTRY_DSN=
